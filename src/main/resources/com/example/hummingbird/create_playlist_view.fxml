<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<HBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.hummingbird.controller.CreatePlaylistController">
   <children>
      <VBox alignment="TOP_CENTER" minWidth="600.0">
         <children>
            <Text fx:id="infoLabel" strokeType="OUTSIDE" strokeWidth="0.0" text="infoLabel">
               <HBox.margin>
                  <Insets bottom="10.0" />
               </HBox.margin>
               <VBox.margin>
                  <Insets bottom="30.0" />
               </VBox.margin></Text>
            <HBox alignment="CENTER">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Playlist name:">
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin>
                  </Text>
                  <TextField fx:id="playlistNameTextField" minWidth="200.0">
                     <HBox.margin>
                        <Insets left="19.0" />
                     </HBox.margin>
                  </TextField>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </HBox>
            <HBox alignment="CENTER">
               <children>
                  <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Search for song:">
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin>
                  </Text>
                  <TextField fx:id="songSearchTextField" maxWidth="-Infinity" minWidth="-Infinity" prefWidth="200.0">
                     <HBox.margin>
                        <Insets left="2.0" />
                     </HBox.margin></TextField>
               </children>
            </HBox>
            <ListView fx:id="mediaListView" prefWidth="500.0">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
            </ListView>
            <HBox alignment="TOP_CENTER">
               <children>
                  <Button fx:id="mediaLibraryButton" mnemonicParsing="false" onAction="#showMediaLibrary" style="-fx-cursor: hand;" text="Media Library">
                     <HBox.margin>
                        <Insets right="2.5" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="addSelectedSongButton" mnemonicParsing="false" onAction="#addSelectedSongToPreviewPlaylist" style="-fx-cursor: hand;" text="Add Selected Song">
                     <HBox.margin>
                        <Insets left="2.5" right="2.5" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="previewPlaylistButton" mnemonicParsing="false" onAction="#showPlaylistPreview" style="-fx-cursor: hand;" text="Preview Playlist">
                     <HBox.margin>
                        <Insets left="2.5" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <Button fx:id="createPlaylistButton" mnemonicParsing="false" onAction="#addPlaylistToManager" style="-fx-cursor: hand;" text="Create Playlist">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="switchToPlaylistManagerViewButton" mnemonicParsing="false" onAction="#loadPlaylistManagerView" style="-fx-cursor: hand;" text="Back to Playlist Manager">
               <VBox.margin>
                  <Insets top="40.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</HBox>
